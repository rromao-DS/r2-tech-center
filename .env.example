# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Postgres local do docker-compose.yml
DATABASE_URL=postgres://r2:r2@localhost:5432/r2

# Auth.js: gere com `npx auth secret`
AUTH_SECRET=
